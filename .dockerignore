# ============================================================
# .dockerignore - Docker 构建时忽略的文件
# ============================================================

# 依赖
node_modules/

# 构建产物
.next/
dist/
out/

# 开发
.git/
.gitignore
*.md
LICENSE

# 测试
coverage/
.nyc_output/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# 系统文件
.DS_Store
Thumbs.db

# 运行时
*.log
npm-debug.log*
pnpm-debug.log*

# Docker
Dockerfile*
docker-compose*
.dockerignore
docker/

# 环境变量（保留 .env.example）
.env
.env.*
!.env.example

# 临时文件
tmp/
temp/
