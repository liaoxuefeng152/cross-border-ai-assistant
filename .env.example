# ============================================================
# 龙掌柜 AI 助手 - 环境变量配置
# 复制此文件为 .env 并填写实际值
# ============================================================

# ---- Supabase 配置（必填） ----
# Supabase URL（本地部署通常是 http://127.0.0.1:54321，云端参见 Supabase 控制台）
COZE_SUPABASE_URL=http://127.0.0.1:54321
# Supabase Anon Key（公开密钥，客户端使用）
COZE_SUPABASE_ANON_KEY=your-anon-key-here
# Supabase Service Role Key（服务端密钥，绕过 RLS）
COZE_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ---- 数据库（如果不用 Supabase 托管，连接裸 PostgreSQL） ----
# POSTGRES_PASSWORD=your-super-secret-password

# ---- 应用配置 ----
# 运行端口
PORT=5000
# 监听地址
HOSTNAME=0.0.0.0
# 运行环境（PROD = 生产模式，其他 = 开发模式）
COZE_PROJECT_ENV=PROD

# ---- 浏览器自动化配置 ----
# 是否显示浏览器窗口（Docker 中必须为 false）
BROWSER_HEADFUL=false
# 浏览器并发会话上限（默认 5）
BROWSER_MAX_SESSIONS=5

# ---- 应用版本 ----
APP_VERSION=1.0.0
